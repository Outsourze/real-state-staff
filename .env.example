# Public canonical URL used by metadata, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://real-state-staff.rovicdelrosario02.workers.dev

# Server-only Resend delivery. Set these as runtime variables/secrets on Cloudflare.
# CONTACT_FROM_EMAIL must be a bare address on a Resend-verified domain.
# CONTACT_TO_EMAIL is your client's real inbox, such as their Google Workspace address.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Optional alternative receiver. Used only when all Resend settings are blank.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=
